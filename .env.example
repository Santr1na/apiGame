# API Keys for Game Data Sources
# Get RAWG API key from: https://rawg.io/apidocs
RAWG_API_KEY=your_rawg_api_key_here

# Get Giant Bomb API key from: https://www.giantbomb.com/api/
GIANT_BOMB_API_KEY=your_giant_bomb_api_key_here

# Get TheGamesDB API key from: https://www.thegamesdb.net/
THEGAMESDB_API_KEY=your_thegamesdb_api_key_here

# Steam API Key (optional, for enhanced Steam features)
# Get from: https://steamcommunity.org/dev/apikey
STEAM_API_KEY=your_steam_api_key_here

# Firebase Configuration (optional, for user authentication)
# Get from your Firebase project settings
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}

# Database Configuration
# Set to false to disable local database and use only API calls
USE_DATABASE=true

# Server Configuration
PORT=3002